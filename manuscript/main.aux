\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Overview of the five experimental settings and their encoding pipelines. \textbf  {S1 (Baseline CoxPH)}: raw features are first passed through a preprocessing step that performs discretisation and standardisation to extract a 39-dimensional numeric vector, which is then fed directly to CoxPH. \textbf  {S2 (Delphi)}: age-tagged ICD tokens are fed to a GPT-based generative transformer in zero-shot mode. \textbf  {S3 Prose}: disease history is serialised as natural-language sentences and encoded by a frozen LLM; the resulting embedding is fused with raw features via concatenation. \textbf  {S3-Full (Full Prose)}: all modalities, including demographics, lab values with units, comorbidity flags, and chronological disease history, are combined into a single clinical paragraph and encoded by the LLM with no raw features concatenated at evaluation time. \textbf  {S4}: age values are mapped to a continuous sinusoidal encoding in parallel with ICD token embeddings; the two streams are concatenated per event, mean-pooled, and fused with raw features.}}{14}{figure.2}\protected@file@percent }
\newlabel{fig:overview}{{2}{14}{Overview of the five experimental settings and their encoding pipelines. \textbf {S1 (Baseline CoxPH)}: raw features are first passed through a preprocessing step that performs discretisation and standardisation to extract a 39-dimensional numeric vector, which is then fed directly to CoxPH. \textbf {S2 (Delphi)}: age-tagged ICD tokens are fed to a GPT-based generative transformer in zero-shot mode. \textbf {S3 Prose}: disease history is serialised as natural-language sentences and encoded by a frozen LLM; the resulting embedding is fused with raw features via concatenation. \textbf {S3-Full (Full Prose)}: all modalities, including demographics, lab values with units, comorbidity flags, and chronological disease history, are combined into a single clinical paragraph and encoded by the LLM with no raw features concatenated at evaluation time. \textbf {S4}: age values are mapped to a continuous sinusoidal encoding in parallel with ICD token embeddings; the two streams are concatenated per event, mean-pooled, and fused with raw features}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Reference-configuration results for the five input-format settings. (A) Harrell C-index; (B) Integrated Brier Score (lower is better); (C) Mean TD-AUC. The dotted line marks the S1 CoxPH baseline value in each panel. All embedding settings use Qwen3-8B with concatenation fusion where applicable.}}{15}{figure.3}\protected@file@percent }
\newlabel{fig:ref_bars}{{3}{15}{Reference-configuration results for the five input-format settings. (A) Harrell C-index; (B) Integrated Brier Score (lower is better); (C) Mean TD-AUC. The dotted line marks the S1 CoxPH baseline value in each panel. All embedding settings use Qwen3-8B with concatenation fusion where applicable}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces TD-AUC by prediction horizon for the five reference configurations. Delphi (S2) rises from near-chance (0.52) at 9.5\,yr to peak (0.65) at 19.7\,yr, while CoxPH-based settings show a comparatively flat profile across horizons.}}{15}{figure.4}\protected@file@percent }
\newlabel{fig:horizon}{{4}{15}{TD-AUC by prediction horizon for the five reference configurations. Delphi (S2) rises from near-chance (0.52) at 9.5\,yr to peak (0.65) at 19.7\,yr, while CoxPH-based settings show a comparatively flat profile across horizons}{figure.4}{}}
